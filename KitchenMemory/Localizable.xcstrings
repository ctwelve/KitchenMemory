        "stringUnit": {
          "state": "translated",
          "value": "Folders and Tags disappear immediately. Recipes are kept."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Las carpetas y etiquetas desaparecen de inmediato. Las recetas se conservan."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Les dossiers et les étiquettes disparaissent immédiatement. Les recettes sont conservées."
        }
      }
    }
  },
