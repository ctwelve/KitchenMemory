    "recipe.editor.simple-help" : {
      "comment" : "Simple recipe editing control or guidance. Ingredient text remains authored; explicit choices protect precise adjustments.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zutat pro Zeile. Mengen sind fett, Einheiten unterstrichen und Zusatzangaben kursiv. Beginne eine Zeile mit # und einem Leerzeichen für einen Abschnitt; entferne beides, um wieder eine Zutat daraus zu machen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One ingredient per line. Quantities are bold, units underlined, and supporting details italic. Start a line with # and a space to make a section; remove them to turn it back into an ingredient."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One ingredient per line. Quantities are bold, units underlined, and supporting details italic. Start a line with # and a space to make a section; remove them to turn it back into an ingredient."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ingrediente por línea. Las cantidades van en negrita, las unidades subrayadas y los detalles en cursiva. Empieza una línea con # y un espacio para crear una sección; elimínalos para volver a convertirla en ingrediente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ingrédient par ligne. Les quantités sont en gras, les unités soulignées et les détails en italique. Commencez une ligne par # et une espace pour créer une section; retirez-les pour en refaire un ingrédient."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ingrediente per riga. Le quantità sono in grassetto, le unità sottolineate e i dettagli in corsivo. Inizia una riga con # e uno spazio per creare una sezione; rimuovili per tornare a un ingrediente."
          }
        }
      }
    },
