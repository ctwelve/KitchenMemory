    "recipe.comparison.existing-draft" : {
      "comment" : "Recipe revision comparison, explicit content choice, or local draft status.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe einen vorhandenen Bearbeitungsentwurf für dieses Rezept ab oder verwirf ihn, bevor du einen Vergleich beginnst. Bei einem Fehler im lokalen Speicher versuche zunächst diesen Vorgang erneut."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish or discard any existing editing draft for this Recipe before starting a comparison. If local storage failed, retry it first."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish or discard any existing editing draft for this Recipe before starting a comparison. If local storage failed, retry it first."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina o descarta el borrador existente de esta receta antes de comparar. Si falló el almacenamiento local, vuelve a intentarlo primero."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez ou abandonnez le brouillon existant de cette recette avant de commencer la comparaison. Si le stockage local a échoué, réessayez d’abord."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa o scarta l’eventuale bozza di modifica di questa Ricetta prima di iniziare un confronto. Se l’archiviazione locale non è riuscita, riprova prima quella operazione."
          }
        }
      }
    },
    "recipe.comparison.explanation" : {
      "comment" : "Recipe revision comparison, explicit content choice, or local draft status.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Ausgangsrevision und übernimm anschließend Felder oder einzelne Zutaten aus beliebigen Revisionen. „Revision speichern“ erstellt eine neue Revision, die alle hier gezeigten Revisionen zusammenführt. Es wird nichts automatisch ausgewählt."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a starting revision, then keep fields or individual ingredients from any revision. Save Revision creates a new revision reconciling every revision shown here. Nothing is selected automatically."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a starting revision, then keep fields or individual ingredients from any revision. Save Revision creates a new revision reconciling every revision shown here. Nothing is selected automatically."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una revisión inicial y conserva campos o ingredientes de cualquier revisión. Guardar revisión crea una nueva revisión que concilia todas las revisiones mostradas. Nada se selecciona automáticamente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une révision de départ, puis conservez des champs ou des ingrédients de chaque révision. Enregistrer la révision crée une nouvelle révision qui concilie toutes les révisions affichées. Rien n’est sélectionné automatiquement."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una revisione iniziale, poi conserva campi o singoli ingredienti da qualsiasi revisione. Salva revisione crea una nuova revisione che riconcilia tutte quelle mostrate qui. Non viene selezionato nulla automaticamente."
          }
        }
      }
    },
