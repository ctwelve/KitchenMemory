    "session.issue.attention" : {
      "comment" : "Explains that retained Cooking Session evidence needs explicit attention and the pending action remains available to retry.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa Sessione di cucina richiede attenzione prima di accettare la modifica. La stessa azione resta disponibile per riprovare."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kochvorgang benötigt Aufmerksamkeit, bevor die Änderung übernommen werden kann. Dieselbe Aktion bleibt für einen erneuten Versuch verfügbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Cooking Session needs attention before that change can be accepted. The same action remains available to retry."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This Cooking Session needs attention before that change can be accepted. The same action remains available to retry." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Esta sesión de cocina necesita atención antes de aceptar ese cambio. La misma acción sigue disponible para volver a intentarla." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Cette séance de cuisine demande votre attention avant que ce changement puisse être accepté. La même action demeure disponible pour une nouvelle tentative." } }
      }
    },
    "session.issue.command" : {
      "comment" : "Explains a local Cooking Session command failure while preserving the stable retry identity.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare la modifica in locale. Riprova; Memoria di cucina ripeterà la stessa azione."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung konnte nicht lokal gespeichert werden. Versuche es erneut; Küchengedächtnis wiederholt dieselbe Aktion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be saved locally. Try again; Kitchen Memory will retry the same action."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "The change could not be saved locally. Try again; Kitchen Memory will retry the same action." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "El cambio no se pudo guardar localmente. Inténtalo de nuevo; Memoria de cocina volverá a intentar la misma acción." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Le changement n’a pas pu être enregistré localement. Réessayez; Mémoire de cuisine tentera de nouveau la même action." } }
      }
    },
    "session.issue.clipboard" : {
