    "recovery.waiting-message" : {
      "comment" : "Explanation for an unavailable non-deleted session.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni dati necessari della sessione non sono ancora arrivati. Riprova dopo la sincronizzazione; non ricreare né modificare questa sessione."
          }
        },
        "de-DE": {
          "stringUnit": {
