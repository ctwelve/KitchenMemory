    "session.delete-descendant-message" : {
      "comment" : "Deletion warning when later sessions continue from this one.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spätere Kochvorgänge setzen diesen fort. Sie, ihre Notizen und die erfassten Rezepte bleiben erhalten. Nur dieser Kochvorgang wird nach „Gelöschte Einträge“ verschoben und bleibt dort wiederherstellbar."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later cooking sessions continue from this one. They, their notes, and their captured recipes will stay intact. Only this session moves to Deleted Items, where it remains recoverable."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later cooking sessions continue from this one. They, their notes, and their captured recipes will stay intact. Only this session moves to Deleted Items, where it remains recoverable."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay sesiones de cocina posteriores que continúan desde esta. Ellas, sus notas y sus recetas capturadas permanecerán intactas. Solo esta sesión se moverá a Elementos eliminados, donde seguirá disponible para recuperar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des séances ultérieures continuent à partir de celle-ci. Elles, leurs notes et leurs recettes capturées resteront intactes. Seule cette séance sera placée dans les éléments supprimés, où elle restera récupérable."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre sessioni di cucina proseguono da questa. Esse, le loro note e le ricette acquisite resteranno intatte. Solo questa sessione viene spostata in Elementi eliminati, dove rimane recuperabile."
          }
        }
      }
    },
