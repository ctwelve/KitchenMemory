        }
      }
    },
    "settings.samples.remove-message": {
      "extractionState": "manual",
      "comment": "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "localizations": {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli esempi non modificati conteggiati qui sotto verranno spostati in Elementi eliminati. Le Ricette modificate, le Cartelle e i Tag rimangono. Potrai ripristinare gli esempi eliminati in seguito."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die unten gezählten unveränderten Beispiele werden nach „Gelöschte Einträge“ verschoben. Bearbeitete Rezepte, Ordner und Tags bleiben erhalten. Gelöschte Beispiele lassen sich später wiederherstellen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the untouched samples counted below will move to Deleted Items. Edited Recipes, Folders and Tags stay. You can restore deleted samples later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the untouched samples counted below will move to Deleted Items. Edited Recipes, Folders and Tags stay. You can restore deleted samples later."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les exemples non modifiés comptés ci-dessous seront déplacés vers les éléments supprimés. Les recettes modifiées, dossiers et étiquettes restent. Vous pourrez restaurer les exemples supprimés."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los ejemplos sin modificar contados abajo se moverán a elementos eliminados. Las recetas editadas, carpetas y etiquetas se conservan. Puedes restaurar los ejemplos después."
          }
        }
      }
    },
