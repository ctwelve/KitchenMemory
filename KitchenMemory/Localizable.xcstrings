    "settings.samples.remove-action": {
      "extractionState": "manual",
      "comment": "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "localizations": {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta gli esempi in Elementi eliminati"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiele nach „Gelöschte Einträge“ verschieben"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Samples to Deleted Items"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Samples to Deleted Items"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les exemples vers les éléments supprimés"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
