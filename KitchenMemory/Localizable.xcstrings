    "settings.icloud.summary" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la raccolta di ricette di questo dispositivo nel tuo database iCloud privato e la rende disponibile in Memoria di cucina sugli altri dispositivi."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Rezeptsammlung dieses Geräts in deiner privaten iCloud-Datenbank und macht sie in Küchengedächtnis auf deinen anderen Geräten verfügbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps this device’s recipe library in your private iCloud database and available to Kitchen Memory on your other devices."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la biblioteca de recetas de este dispositivo en tu base de datos privada de iCloud y disponible en Memoria de cocina en tus otros dispositivos."
          }
