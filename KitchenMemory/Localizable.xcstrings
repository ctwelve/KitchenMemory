    "recipe.import.privacy.fetching" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria di cucina segue i reindirizzamenti e scarica l’HTML risultante con una richiesta temporanea senza cookie né credenziali dell’app. Durante la verifica non esegue script della pagina né scarica immagini."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Küchengedächtnis folgt Weiterleitungen und lädt das resultierende HTML mit einer kurzlebigen Anfrage ohne Cookies oder App-Zugangsdaten herunter. Während der Prüfung werden weder Seitenskripte ausgeführt noch Bilder heruntergeladen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitchen Memory follows redirects and downloads the resulting HTML with an ephemeral request that supplies no cookies or app credentials. It runs no page scripts and downloads no images during review."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria de cocina sigue las redirecciones y descarga el HTML resultante mediante una solicitud efímera que no proporciona cookies ni credenciales de la app. No ejecuta scripts de la página ni descarga imágenes durante la revisión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire de cuisine suit les redirections et télécharge le HTML résultant au moyen d’une requête éphémère qui ne fournit aucun témoin ni identifiant de l’app. Aucun script de page n’est exécuté et aucune image n’est téléchargée pendant la révision."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitchen Memory follows redirects and downloads the resulting HTML with an ephemeral request that supplies no cookies or app credentials. It runs no page scripts and downloads no images during review."
          }
        }
      },
      "comment" : "Privacy explanation of the bounded, credential-free webpage request. Preserve every limitation.",
      "extractionState" : "manual"
    },
    "recipe.import.privacy.storage" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione conserva subito il riferimento alla fonte e un blocco limitato di metadati JSON-LD in Memoria di cucina, inclusi i campi non mostrati nella verifica. Candidati e bozze restano solo su questo dispositivo finché non salvi una revisione nella cucina. I documenti locali vengono letti senza accesso alla rete."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Import werden der Quellverweis und ein begrenzter JSON-LD-Metadatenblock sofort in Küchengedächtnis aufbewahrt, einschließlich der bei der Prüfung nicht angezeigten Felder. Kandidaten und Entwürfe bleiben ausschließlich auf diesem Gerät, bis du eine Revision in der Küche speicherst. Lokale Dokumente werden ohne Netzwerkzugriff gelesen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing immediately retains the source reference and one bounded JSON-LD metadata block in Kitchen Memory, including fields not shown in review. Candidates and drafts stay only on this device until you save a revision into the kitchen. Local documents are read without network access."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al importar, Memoria de cocina conserva inmediatamente la referencia de origen y un bloque limitado de metadatos JSON-LD, incluso los campos no mostrados en la revisión. Los candidatos y borradores permanecen solo en este dispositivo hasta que guardes una revisión en la cocina. Los documentos locales se leen sin acceso a la red."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de l’importation, Mémoire de cuisine conserve immédiatement la référence source et un bloc limité de métadonnées JSON-LD, y compris les champs non affichés dans la révision. Les candidats et brouillons restent uniquement sur cet appareil jusqu’à l’enregistrement d’une révision dans la cuisine. Les documents locaux sont lus sans accès au réseau."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importing immediately retains the source reference and one bounded JSON-LD metadata block in Kitchen Memory, including fields not shown in review. Candidates and drafts stay only on this device until you save a revision into the kitchen. Local documents are read without network access."
          }
        }
      },
      "comment" : "Privacy explanation of immediate device-local staging and the explicit Save Revision synchronization boundary.",
      "extractionState" : "manual"
    },
