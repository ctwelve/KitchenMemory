    "recovery.invariant-message" : {
      "comment" : "Safe next action for malformed or conflicting evidence.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati probatori disponibili della sessione non concordano in modo sicuro. Non è stato scartato nulla. Riprova dopo che la sincronizzazione avrà portato gli eventuali dati mancanti."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verfügbaren Nachweise zum Kochvorgang lassen sich nicht sicher miteinander vereinbaren. Es wurde nichts verworfen. Versuche es erneut, nachdem die Synchronisierung weitere Daten übertragen hat."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The available session evidence does not safely agree. Nothing was discarded. Try again after synchronisation brings any remaining data."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "The available session evidence does not safely agree. Nothing was discarded. Try again after synchronization brings any remaining data." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "La evidencia disponible de la sesión no concuerda de forma segura. No se descartó nada. Inténtalo de nuevo después de que la sincronización aporte los datos restantes." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Les éléments disponibles de la séance ne concordent pas de façon sûre. Rien n’a été supprimé. Réessayez après la synchronisation des données restantes." } }
      }
    },
    "recovery.message" : {
      "comment" : "Recovery destination introduction.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sessioni restano fuori dalla cronologia ordinaria finché i loro dati probatori non sono completi e sicuri da ricostruire."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kochvorgänge bleiben außerhalb des gewöhnlichen Verlaufs, bis ihre Nachweise vollständig sind und eine sichere Rekonstruktion erlauben."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These sessions are kept out of ordinary history until their evidence is complete and safe to rebuild."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "These sessions are kept out of ordinary history until their evidence is complete and safe to rebuild." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Estas sesiones se mantienen fuera del historial normal hasta que su evidencia esté completa y sea seguro reconstruirlas." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Ces séances restent hors de l’historique ordinaire jusqu’à ce que leurs éléments soient complets et sûrs à reconstruire." } }
      }
