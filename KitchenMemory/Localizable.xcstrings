    "session.restore-confirmation-message" : {
      "comment" : "Explains observed-only causal restoration.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung berücksichtigt alle derzeit auf diesem Gerät sichtbaren Löschungen. Trifft später eine weitere Löschung ein, bleibt der Kochvorgang unter „Gelöschte Einträge“ und benötigt deine Aufmerksamkeit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore will resolve every deletion currently visible on this device. If another deletion arrives later, the session will remain in Deleted Items for your attention."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
