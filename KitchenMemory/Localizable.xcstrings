    "session.entry.detached.message" : {
      "comment" : "Explains explicit choices when remote evidence Finishes a Session that still has a local draft.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa Sessione è stata conclusa altrove. Proseguila per continuare a scrivere, copia la bozza oppure scartala. Una bozza proseguita conserva il riferimento corrispondente, se esiste; altrimenti diventa una bozza per l’intera Sessione."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kochvorgang wurde auf einem anderen Gerät abgeschlossen. Setze ihn fort, um weiterzuschreiben, kopiere den Entwurf oder verwirf ihn. Ein fortgesetzter Entwurf behält seinen passenden Bezug, sofern vorhanden; andernfalls bezieht er sich auf den gesamten Kochvorgang."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Session was Finished elsewhere. Continue it to keep writing, copy the draft, or discard it. A continued draft keeps its matching target when one exists; otherwise it becomes a whole-Session draft."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This Session was Finished elsewhere. Continue it to keep writing, copy the draft, or discard it. A continued draft keeps its matching target when one exists; otherwise it becomes a whole-Session draft." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Esta sesión se finalizó en otro lugar. Continúala para seguir escribiendo, copia el borrador o descártalo. Un borrador continuado conserva su objetivo correspondiente cuando existe; de lo contrario, se convierte en un borrador de toda la sesión." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Cette séance a été terminée ailleurs. Continuez-la pour écrire, copiez le brouillon ou jetez-le. Un brouillon continué conserve sa cible correspondante lorsqu’elle existe; sinon, il devient un brouillon pour toute la séance." } }
      }
    },
    "session.entry.detached.title" : {
      "comment" : "Title for resolving a local draft after remote Finish evidence arrives.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bozza locale cerca ancora posto"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lokaler Entwurf braucht noch einen Platz"
          }
        },
        "en-GB": {
