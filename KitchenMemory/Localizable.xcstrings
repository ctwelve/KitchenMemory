    "settings.samples.intent-message": {
      "extractionState": "manual",
      "comment": "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "localizations": {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa impostazione registra la tua ultima richiesta. Le modifiche su altri dispositivi non installano né rimuovono mai le Ricette automaticamente."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellung speichert deine letzte Anfrage. Änderungen auf anderen Geräten installieren oder entfernen Rezepte niemals automatisch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting records your last request. Changes on other devices never install or remove Recipes automatically."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting records your last request. Changes on other devices never install or remove Recipes automatically."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage indique votre dernière demande. Les changements sur d’autres appareils n’installent ni ne suppriment automatiquement des recettes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste registra tu última solicitud. Los cambios en otros dispositivos nunca instalan ni eliminan recetas automáticamente."
          }
        }
      }
    },
    "settings.samples.remove-title": {
      "extractionState": "manual",
      "comment": "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "localizations": {
