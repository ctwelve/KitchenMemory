    "settings.samples.intent-message" : {
      "comment" : "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung speichert deine letzte Anfrage. Änderungen auf anderen Geräten installieren oder entfernen Rezepte niemals automatisch."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
