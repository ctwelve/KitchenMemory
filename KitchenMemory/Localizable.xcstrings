        }
      }
    }
  },
  "recipe.recovery.retry": {
    "comment": "Recipe Recovery: incomplete evidence and explicitly lossy creation of a new local draft.",
    "extractionState": "manual",
    "localizations": {
      "it-IT": {
        "stringUnit": {
          "state": "translated",
          "value": "I dati probatori potrebbero essere cambiati oppure l’archivio locale delle bozze potrebbe non essere disponibile. Aggiorna e riprova."
        }
      },
      "de-DE": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Nachweise könnten sich geändert haben oder der lokale Entwurfsspeicher ist möglicherweise nicht verfügbar. Aktualisiere die Ansicht und versuche es erneut."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "The evidence may have changed or local draft storage may be unavailable. Refresh and try again."
        }
      },
      "en-US": {
        "stringUnit": {
          "state": "translated",
          "value": "The evidence may have changed or local draft storage may be unavailable. Refresh and try again."
        }
      },
      "es-MX": {
        "stringUnit": {
          "state": "translated",
          "value": "Los datos pueden haber cambiado o el almacenamiento local no está disponible. Actualiza e inténtalo de nuevo."
        }
      },
      "fr-CA": {
        "stringUnit": {
          "state": "translated",
          "value": "Les données ont peut-être changé ou le stockage local est indisponible. Actualisez et réessayez."
        }
      }
    }
  }
,

