    "deleted.items.retention-message" : {
      "comment" : "Explains reversible deletion without storage vocabulary.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Einträge bleiben wiederherstellbar und behalten ihren ursprünglichen Kochzustand. Das Leeren von „Gelöschte Einträge“ ist noch nicht verfügbar."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay recoverable and keep their original cooking state. Emptying Deleted Items is not available yet."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay recoverable and keep their original cooking state. Emptying Deleted Items is not available yet."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos eliminados se pueden recuperar y conservan su estado de cocina original. Aún no es posible vaciar Elementos eliminados."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments supprimés restent récupérables et conservent leur état de cuisine. Il n’est pas encore possible de vider les éléments supprimés."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi eliminati restano recuperabili e mantengono lo stato di cucina originale. Non è ancora possibile svuotare Elementi eliminati."
          }
        }
      }
    },
