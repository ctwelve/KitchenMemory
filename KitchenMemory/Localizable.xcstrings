    },
    "settings.icloud.reconnect.message" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla prossima apertura di Memoria di cucina, le ricette e la cronologia delle revisioni di questo dispositivo verranno unite a iCloud. Le modifiche o le rimozioni effettuate in una delle raccolte durante la disconnessione possono influire sulla raccolta risultante. Controllala al termine della sincronizzazione."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Öffnen von Küchengedächtnis werden Rezepte und Revisionsverlauf dieses Geräts mit iCloud zusammengeführt. Änderungen oder Löschungen während der Trennung können sich auf die zusammengeführte Sammlung auswirken. Prüfe sie nach der Synchronisierung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The next time you open Kitchen Memory, recipes and revision history from this device will merge with iCloud. Changes or removals made in either library while disconnected may affect the combined library. Review it after sync finishes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La próxima vez que abras Memoria de cocina, las recetas y el historial de revisiones de este dispositivo se combinarán con iCloud. Los cambios o eliminaciones realizados en cualquiera de las bibliotecas mientras estuvieron desconectadas pueden afectar la biblioteca combinada. Revísala cuando termine la sincronización."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prochaine fois que vous ouvrirez Mémoire de cuisine, les recettes et l’historique des révisions de cet appareil seront fusionnés avec iCloud. Les modifications ou suppressions apportées dans l’une ou l’autre bibliothèque pendant la déconnexion peuvent affecter la bibliothèque fusionnée. Vérifiez-la une fois la synchronisation terminée."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next time you open Kitchen Memory, recipes and revision history from this device will merge with iCloud. Changes or removals made in either library while disconnected may affect the combined library. Review it after sync finishes."
          }
        }
      },
      "comment" : "Explains that reconnecting a long-disconnected device merges divergent local and iCloud history rather than choosing one copy silently.",
      "extractionState" : "manual"
    },
