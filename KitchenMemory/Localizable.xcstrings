    "settings.icloud.stale-evidence" : {
      "comment" : "Settings warning after seven days without a successful managed import or export observed for this local store. This reports risk only; never implies that all devices are synchronized.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non osserva un trasferimento iCloud riuscito da circa una settimana. La sincronizzazione futura potrebbe essere meno affidabile e il rischio di perdita dei dati potrebbe aumentare."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat seit etwa einer Woche keine erfolgreiche iCloud-Übertragung beobachtet. Künftige Synchronisierungen könnten weniger zuverlässig sein und das Risiko eines Datenverlusts könnte steigen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has not observed a successful iCloud transfer for about a week. Future synchronisation may be less reliable, and the risk of losing data may increase."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has not observed a successful iCloud transfer for about a week. Future synchronization may be less reliable, and the risk of losing data may increase."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no ha observado una transferencia de iCloud exitosa en aproximadamente una semana. La sincronización futura podría ser menos confiable y el riesgo de perder datos podría aumentar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’a pas observé de transfert iCloud réussi depuis environ une semaine. La synchronisation pourrait devenir moins fiable et le risque de perte de données pourrait augmenter."
          }
        }
      }
    },
