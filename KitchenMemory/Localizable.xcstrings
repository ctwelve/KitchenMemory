  "organization.delete-message": {
    "comment": "Recipe Library organization: Folders and Tags disappear immediately. Recipes are kept.. Folder location and Tag classification are independent of Recipe content.",
    "extractionState": "manual",
    "localizations": {
      "it-IT": {
        "stringUnit": {
          "state": "translated",
          "value": "Cartelle e Tag scompaiono immediatamente. Le Ricette vengono conservate."
        }
      },
      "de-DE": {
        "stringUnit": {
          "state": "translated",
          "value": "Ordner und Tags verschwinden sofort. Rezepte bleiben erhalten."
        }
      },
      "en-GB": {
        "stringUnit": {
          "state": "translated",
          "value": "Folders and Tags disappear immediately. Recipes are kept."
        }
      },
