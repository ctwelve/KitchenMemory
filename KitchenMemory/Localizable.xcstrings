          "stringUnit" : {
            "state" : "translated",
            "value" : "El material privado de depuración se elimina cuando termina la necesidad inmediata. Nunca se publica ni se conserva como datos de prueba."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
