        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prochaine fois que vous ouvrirez Kitchen Memory, les recettes et l’historique des révisions de cet appareil seront fusionnés avec iCloud. Les modifications ou suppressions apportées dans l’une ou l’autre bibliothèque pendant la déconnexion peuvent affecter la bibliothèque fusionnée. Vérifiez-la une fois la synchronisation terminée."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next time you open Kitchen Memory, recipes and revision history from this device will merge with iCloud. Changes or removals made in either library while disconnected may affect the combined library. Review it after sync finishes."
