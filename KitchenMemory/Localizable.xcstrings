    "Private debugging material is deleted when the immediate need ends. It is never published or retained as test data." : {
      "localizations" : {
        "base" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Private debugging material is deleted when the immediate need ends. It is never published or retained as test data."
          }
        },
