    "settings.reset.confirmation.message" : {
      "localizations" : {
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todas las recetas, ediciones, historiales de revisión, capturas de origen importadas y metadatos de recetas de esta cocina. Kitchen Memory restaurará únicamente las recetas de muestra incluidas en esta versión. Esta acción no se puede deshacer."
