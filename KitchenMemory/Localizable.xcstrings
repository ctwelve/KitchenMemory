    "recipe.recovery.explanation" : {
      "comment" : "Recipe Recovery: incomplete evidence and explicitly lossy creation of a new local draft.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den aufbewahrten oder verspätet eintreffenden Nachweisen lässt sich dieses Rezept derzeit nicht rekonstruieren. Versuche es erneut, wenn weitere Nachweise eingetroffen sind, oder beginne mit dem verfügbaren Inhalt ein neues Rezept."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retained or late-arriving evidence cannot currently reconstruct this Recipe. Retry after more evidence arrives, or start a new Recipe from the available content."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retained or late-arriving evidence cannot currently reconstruct this Recipe. Retry after more evidence arrives, or start a new Recipe from the available content."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos conservados o recibidos tarde no permiten reconstruir esta receta. Inténtalo de nuevo cuando lleguen más datos o crea una receta nueva con el contenido disponible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données conservées ou reçues en retard ne permettent pas de reconstruire cette recette. Réessayez après réception de données supplémentaires ou créez une recette avec le contenu disponible."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati probatori conservati o arrivati in ritardo non permettono al momento di ricostruire questa Ricetta. Riprova dopo l’arrivo di altri dati oppure inizia una nuova Ricetta con il contenuto disponibile."
          }
        }
      }
    },
    "recipe.recovery.loss-warning" : {
      "comment" : "Recipe Recovery: incomplete evidence and explicitly lossy creation of a new local draft.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabei können fehlende Inhalte, Verlauf und Beziehungen verloren gehen. Es entsteht ein bearbeitbarer lokaler Entwurf mit neuer Identität; das ursprüngliche Rezept wird nicht wiederhergestellt. Prüfe den Entwurf vor dem Speichern."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This may lose missing content, history, and relationships. It creates an editable local draft with a new identity; it does not restore the original Recipe. Review it before saving."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This may lose missing content, history, and relationships. It creates an editable local draft with a new identity; it does not restore the original Recipe. Review it before saving."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrían perderse contenido, historial y relaciones faltantes. Se creará un borrador local editable con una identidad nueva; no se restaurará la receta original. Revísalo antes de guardarlo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du contenu, de l’historique et des liens manquants pourraient être perdus. Un brouillon local modifiable avec une nouvelle identité sera créé; la recette originale ne sera pas restaurée. Vérifiez-le avant de l’enregistrer."
          }
        },
        "it-IT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbero andare persi contenuti mancanti, cronologia e relazioni. Verrà creata una bozza locale modificabile con una nuova identità; la Ricetta originale non verrà ripristinata. Controllala prima di salvarla."
          }
        }
      }
    },
