    "settings.samples.remove-message" : {
      "comment" : "Sample pack setting. Organization names are ordinary user-editable names; the Tag name excludes the display hash.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die unten gezählten unveränderten Beispiele werden nach „Gelöschte Einträge“ verschoben. Bearbeitete Rezepte, Ordner und Tags bleiben erhalten. Gelöschte Beispiele lassen sich später wiederherstellen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the untouched samples counted below will move to Deleted Items. Edited Recipes, Folders and Tags stay. You can restore deleted samples later."
          }
        },
        "en-US" : {
          "stringUnit" : {
