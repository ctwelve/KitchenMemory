    "All recipes, edits, revision history, imported source captures, and recipe metadata in this Kitchen will be permanently deleted. Kitchen Memory will restore only the sample recipes included with this version. This cannot be undone." : {
      "localizations" : {
        "base" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "All recipes, edits, revision history, imported source captures, and recipe metadata in this Kitchen will be permanently deleted. Kitchen Memory will restore only the sample recipes included with this version. This cannot be undone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todas las recetas, ediciones, historiales de revisión, capturas de origen importadas y metadatos de recetas de esta cocina. Kitchen Memory restaurará únicamente las recetas de muestra incluidas en esta versión. Esta acción no se puede deshacer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les recettes, modifications, historiques de révision, captures de sources importées et métadonnées de recettes de cette cuisine seront supprimés définitivement. Kitchen Memory restaurera uniquement les exemples de recettes inclus dans cette version. Cette action est irréversible."
          }
        }
      }
    },
