          "stringUnit": {
            "state": "translated",
            "value": "Altre sessioni di cucina proseguono da questa. Esse, le loro note e le ricette acquisite resteranno intatte. Solo questa sessione viene spostata in Elementi eliminati, dove rimane recuperabile."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätere Kochvorgänge setzen diesen fort. Sie, ihre Notizen und die erfassten Rezepte bleiben erhalten. Nur dieser Kochvorgang wird nach „Gelöschte Einträge“ verschoben und bleibt dort wiederherstellbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Later cooking sessions continue from this one. They, their notes, and their captured recipes will stay intact. Only this session moves to Deleted Items, where it remains recoverable."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Later cooking sessions continue from this one. They, their notes, and their captured recipes will stay intact. Only this session moves to Deleted Items, where it remains recoverable." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Hay sesiones de cocina posteriores que continúan desde esta. Ellas, sus notas y sus recetas capturadas permanecerán intactas. Solo esta sesión se moverá a Elementos eliminados, donde seguirá disponible para recuperar." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Des séances ultérieures continuent à partir de celle-ci. Elles, leurs notes et leurs recettes capturées resteront intactes. Seule cette séance sera placée dans les éléments supprimés, où elle restera récupérable." } }
      }
    },
    "session.restore-action" : {
      "comment" : "Action to causally restore observed deletion markers.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Restore" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Restaurar" } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Restaurer" } }
      }
    },
    "session.restore-confirmation-message" : {
      "comment" : "Explains observed-only causal restoration.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino risolve tutte le eliminazioni attualmente visibili su questo dispositivo. Se ne arriva un’altra in seguito, la sessione resterà in Elementi eliminati e richiederà la tua attenzione."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung berücksichtigt alle derzeit auf diesem Gerät sichtbaren Löschungen. Trifft später eine weitere Löschung ein, bleibt der Kochvorgang unter „Gelöschte Einträge“ und benötigt deine Aufmerksamkeit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore will resolve every deletion currently visible on this device. If another deletion arrives later, the session will remain in Deleted Items for your attention."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Restore will resolve every deletion currently visible on this device. If another deletion arrives later, the session will remain in Deleted Items for your attention." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Restaurar resolverá todas las eliminaciones visibles actualmente en este dispositivo. Si llega otra eliminación después, la sesión permanecerá en Elementos eliminados para que la revises." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "La restauration résoudra toutes les suppressions actuellement visibles sur cet appareil. Si une autre suppression arrive plus tard, la séance restera dans les éléments supprimés afin d’être examinée." } }
      }
    },
