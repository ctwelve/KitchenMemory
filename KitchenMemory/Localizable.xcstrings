    "recovery.invariant-message" : {
      "comment" : "Safe next action for malformed or conflicting evidence.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verfügbaren Nachweise zum Kochvorgang lassen sich nicht sicher miteinander vereinbaren. Es wurde nichts verworfen. Versuche es erneut, nachdem die Synchronisierung weitere Daten übertragen hat."
