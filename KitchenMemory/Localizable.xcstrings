    },
    "privacy.debugging.retention" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Il materiale diagnostico privato viene eliminato quando termina la necessità immediata. Non viene mai pubblicato né conservato come dato di prova."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Privates Diagnosematerial wird gelöscht, sobald es nicht mehr unmittelbar benötigt wird. Es wird niemals veröffentlicht oder als Testdaten aufbewahrt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Private debugging material is deleted when the immediate need ends. It is never published or retained as test data."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El material privado de depuración se elimina cuando termina la necesidad inmediata. Nunca se publica ni se conserva como datos de prueba."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le matériel privé de débogage est supprimé dès que le besoin immédiat prend fin. Il n’est jamais publié ni conservé comme données de test."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private debugging material is deleted when the immediate need ends. It is never published or retained as test data."
          }
        }
      },
      "comment" : "Privacy commitment covering deletion, publication, and test-data retention of debugging material.",
      "extractionState" : "manual"
    },
