      },
      "de-DE": {
        "stringUnit": {
          "state": "translated",
          "value": "Das Rezept wird nach „Gelöschte Einträge“ verschoben. Sein Verlauf, lokale Entwürfe und Kochvorgänge bleiben erhalten."
        }
      },
      "en-GB": {
