    "session.delete-confirmation-message" : {
      "comment" : "Standard reversible session deletion warning.",
      "extractionState" : "manual",
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sessione verrà spostata in Elementi eliminati senza cambiare il suo stato: Attiva, Interrotta o Conclusa. Il suo resoconto di cucina resta recuperabile."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kochvorgang wird nach „Gelöschte Einträge“ verschoben. Sein Zustand – Aktiv, Angehalten oder Abgeschlossen – bleibt unverändert. Sein Kochprotokoll bleibt wiederherstellbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This session will move to Deleted Items without changing whether it is Active, Stopped, or Finished. Its cooking record stays recoverable."
          }
        },
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This session will move to Deleted Items without changing whether it is Active, Stopped, or Finished. Its cooking record stays recoverable." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Esta sesión se moverá a Elementos eliminados sin cambiar si está activa, detenida o finalizada. Su registro de cocina se podrá recuperar." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Cette séance sera placée dans les éléments supprimés sans changer son état actif, arrêté ou terminé. Son historique restera récupérable." } }
      }
    },
