    "recipe.editor.draft-failure.message": {
      "comment": "Explains a local read/write failure without promising durability.",
      "extractionState": "manual",
      "localizations": {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere o salvare i dati di modifica. Mantieni qui il lavoro aperto e riprova. I file delle bozze esistenti non sono stati scartati."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitungsdaten konnten nicht gelesen oder gespeichert werden. Lass offene Arbeit hier bestehen und versuche es erneut. Vorhandene Entwurfsdateien wurden nicht verworfen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing data could not be read or saved. Keep any open work here and try again. Existing draft files have not been discarded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing data could not be read or saved. Keep any open work here and try again. Existing draft files have not been discarded."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer o guardar los datos de edición. Mantén aquí cualquier trabajo abierto e inténtalo de nuevo. No se han descartado los archivos de borrador existentes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de modification n’ont pas pu être lues ou enregistrées. Gardez ici tout travail ouvert et réessayez. Les fichiers de brouillon existants n’ont pas été supprimés."
          }
        }
      }
    },
