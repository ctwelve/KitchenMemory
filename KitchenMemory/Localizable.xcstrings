    "privacy.debugging.inspection" : {
      "localizations" : {
        "it-IT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esaminiamo informazioni private solo quando le fornisci deliberatamente per diagnosticare un problema."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sehen private Informationen nur ein, wenn du sie bewusst zur Untersuchung eines Problems bereitstellst."
          }
