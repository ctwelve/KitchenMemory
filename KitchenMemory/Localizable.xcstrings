        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Rezeptsammlung dieses Geräts in deiner privaten iCloud-Datenbank und macht sie in Küchengedächtnis auf deinen anderen Geräten verfügbar."
          }
        },
        "en-GB" : {
