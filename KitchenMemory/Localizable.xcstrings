      "localizations" : {
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Copy and remove draft" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Copiar y eliminar borrador" } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Copier et retirer le brouillon" } }
      }
    },
    "session.entry.detached.discard" : {
      "comment" : "Destructive action that removes a draft belonging to a remotely Finished Session.",
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "Discard draft" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Descartar borrador" } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Jeter le brouillon" } }
      }
    },
    "session.entry.detached.message" : {
      "comment" : "Explains explicit choices when remote evidence Finishes a Session that still has a local draft.",
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This Session was Finished elsewhere. Continue it to keep writing, copy the draft, or discard it. A continued draft keeps its matching target when one exists; otherwise it becomes a whole-Session draft." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Esta sesión se finalizó en otro lugar. Continúala para seguir escribiendo, copia el borrador o descártalo. Un borrador continuado conserva su objetivo correspondiente cuando existe; de lo contrario, se convierte en un borrador de toda la sesión." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Cette séance a été terminée ailleurs. Continuez-la pour écrire, copiez le brouillon ou jetez-le. Un brouillon continué conserve sa cible correspondante lorsqu’elle existe; sinon, il devient un brouillon pour toute la séance." } }
      }
    },
    "session.entry.detached.title" : {
      "comment" : "Title for resolving a local draft after remote Finish evidence arrives.",
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "A local draft still needs a home" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Un borrador local aún necesita un lugar" } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Un brouillon local a encore besoin d’un endroit" } }
      }
    },
    "session.entry.draft.note" : {
      "comment" : "Explains the device-local and unsubmitted nature of a Session Entry draft.",
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : { "stringUnit" : { "state" : "translated", "value" : "This draft stays on this device and is not Session evidence until you add it." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Este borrador permanece en este dispositivo y no es evidencia de la sesión hasta que lo agregues." } },
        "fr-CA" : { "stringUnit" : { "state" : "translated", "value" : "Ce brouillon reste sur cet appareil et ne constitue pas une preuve de séance avant son ajout." } }
      }
    },
    "session.entry.draft.placeholder" : {
      "comment" : "Placeholder inviting text-first observation capture during a Cooking Session.",
