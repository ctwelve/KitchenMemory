					<dict>
						<key>id</key>
						<string>D51F5CF2-FD10-5014-B1AC-4F600F71B2A1</string>
						<key>text</key>
						<string>Die Nudeln mit etwas Olivenöl, 2 US-Esslöffeln Butter sowie schwarzem Pfeffer, italienischer Kräutermischung, Knoblauch- und Zwiebelpulver nach Geschmack vermengen.</string>
					</dict>
